{
  "name": "@am_n_n/pi-subagents",
  "version": "0.1.0",
  "description": "Isolated single-task subagents for Pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amnn/pi-subagents.git"
  },
  "homepage": "https://github.com/amnn/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/amnn/pi-subagents/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "subagents",
    "coding-agent"
  ],
  "license": "Apache-2.0",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "smoke": "pi --offline --no-extensions -e . --list-models __pi_package_smoke__",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm test && pnpm run smoke && pnpm audit",
    "prepublishOnly": "pnpm check"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "22.19.19",
    "prettier": "3.3.3",
    "tsx": "^4.23.1",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  }
}
